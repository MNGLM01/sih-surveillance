# Surveillance Pipeline Environment Configuration
# Copy this file to .env or set environment variables directly.

# --- GPU Acceleration Configuration ---
# Set YOLO inference device.
# For NVIDIA CUDA GPU acceleration (default if CUDA is detected):
YOLO_DEVICE=cuda:0
# For CPU fallback:
# YOLO_DEVICE=cpu

# --- Ingestion & Streaming Performance Knobs ---
# Maximum dimension for ingested frames (downscales UHD/4K to save RAM and accelerate YOLO)
INGEST_MAX_DIM=1024

# Target maximum streaming FPS
MAX_STREAM_FPS=30.0

# YOLO input image resolution (square size, e.g. 480 or 640)
YOLO_IMGSZ=480

# Pipeline frame skip: process full ML pipeline (YOLO + tracking + behavior + ANPR)
# every Nth frame, annotating intermediate frames with cached results for smooth display.
PIPELINE_SKIP_FRAMES=3

# Stream JPEG compression quality (1-100)
STREAM_JPEG_QUALITY=65

# Stream output max width in pixels
STREAM_MAX_WIDTH=720

# --- Automatic Number Plate Recognition (ANPR) ---
ANPR_ENABLED=true
ANPR_FRAME_INTERVAL=5
ANPR_PLATE_MODEL_PATH=license_plate_detector.pt
ANPR_PLATE_CONFIDENCE=0.4
ANPR_OCR_CONFIDENCE=0.35
ANPR_MIN_CONSENSUS_READINGS=2
ANPR_MAX_TRACK_HISTORY=50
ANPR_EVIDENCE_IMAGES=true

# --- Risk & Incident Sensitivity ---
FORCE_AFTER_HOURS=false
RISK_CRITICAL_BAND=90
RISK_HIGH_BAND=70
RISK_MEDIUM_BAND=30
VIRTUAL_FENCE_BUFFER_NORM=0.08
